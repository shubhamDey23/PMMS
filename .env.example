# =====================================================================
# eSapmada: DMFT Work Monitoring Portal — Environment Configuration
# =====================================================================
#
# IMPORTANT:
# - Copy this file to .env.local for local development.
# - In production (e.g., Vercel / State Data Center), set these in Environment Variables.
# - Never commit real production secrets or API keys to version control.

# ---------------------------------------------------------------------
# 1. Administrator Authentication Credentials
# ---------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345

# ---------------------------------------------------------------------
# 2. Cryptographic Session Secret (Min 32 characters HMAC-SHA256)
# ---------------------------------------------------------------------
SESSION_SECRET=8fA2kL9vQ4xR7mN1pW6zB3cY5hT0jD8sG2uE9iF4oV7nK1aM6rX3qP5wH8bL0zC2

# ---------------------------------------------------------------------
# 3. AI Assistant Configuration (Server-Side Only - Never Exposed to Frontend)
# ---------------------------------------------------------------------
# Default AI Provider: 'gemini' (recommended) or 'openai'
AI_PROVIDER=gemini

# Google Gemini API Key (Obtain free from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: OpenAI API Key (if AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------
# 4. PostgreSQL Database & pgvector Extension (Production Vector Storage)
# ---------------------------------------------------------------------
# For production RAG vector indexing with PostgreSQL pgvector:
POSTGRES_URL=postgresql://esapmada_admin:secure_password@localhost:5432/esapmada_dmft
